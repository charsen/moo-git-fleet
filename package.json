{
  "name": "moo-git-fleet",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "description": "Moo Fleet — local-first multi-repository Git workbench.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "rm -rf dist && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup src/server/index.ts --format esm --platform node --target node20 --out-dir dist/server",
    "build:server:mac": "tsup --config tsup.mac.config.ts",
    "build:mac": "MOO_FLEET_MAC_ARCH=arm64 zsh scripts/build-macos-app.sh",
    "build:mac:x64": "MOO_FLEET_MAC_ARCH=x64 zsh scripts/build-macos-app.sh",
    "build:mac:all": "npm run build:mac && npm run build:mac:x64",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:mac-native": "MOO_FLEET_MAC_ARCH=arm64 zsh scripts/test-macos-native.sh",
    "test:mac-native:x64": "MOO_FLEET_MAC_ARCH=x64 zsh scripts/test-macos-native.sh",
    "test:mac-install-e2e": "MOO_FLEET_MAC_ARCH=arm64 zsh scripts/test-macos-install-e2e.sh",
    "test:mac-install-e2e:x64": "MOO_FLEET_MAC_ARCH=x64 zsh scripts/test-macos-install-e2e.sh",
    "stress:scan": "tsx scripts/scan-stress.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@tanstack/vue-query": "^5.83.0",
    "fastify": "^5.4.0",
    "lucide-vue-next": "^0.525.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    }
  }
}
